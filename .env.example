# Copy to .env and adjust. Values already set in the environment take precedence.

# The Anthropic SDK reads ANTHROPIC_API_KEY, or a profile created with
# `ant auth login`. Leave this commented out to use the profile.
# ANTHROPIC_API_KEY=sk-ant-...

# Model used for answers.
GQA_MODEL=claude-opus-5-5

# Where `gqa index` writes the index and the other commands read it.
GQA_INDEX_DIR=.gqa_index

# Chunks retrieved per question, and the minimum support (0 to 1) below which
# a question is treated as not covered by the documents.
GQA_TOP_K=5
GQA_MIN_SUPPORT=0.5

# Who to suggest when the documents do not have the answer.
GQA_CONTACT="Northwind technical support (support@northwind-heating.example)"

# Optional dense embedder used by `gqa index`, as package.module:factory.
# GQA_EMBEDDER=mypackage.embeddings:make_embedder
